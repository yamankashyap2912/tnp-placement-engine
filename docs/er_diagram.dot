digraph TnP {
  rankdir=LR; fontname="Helvetica"; nodesep=0.35; ranksep=1.1;
  node [shape=plaintext fontname="Helvetica" fontsize=10];
  edge [color="#555555" arrowsize=0.7];
  App_Users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#cfe8ff"><B>App_Users</B></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><B>PK user_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="username">   username</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash">   password_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role">   role</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">enum(&#x27;ADMIN&#x27;,&#x27;RECRUITER&#x27;,&#x27;STUDENT&#x27;)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="display_name">   display_name</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="student_id">FK student_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="company_id">FK company_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_active">   is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">tinyint(1)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">   created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_login_at">   last_login_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamp</FONT></TD></TR></TABLE>>];
  Application_Status_Log [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#ffe9b8"><B>Application_Status_Log</B></TD></TR><TR><TD ALIGN="LEFT" PORT="log_id"><B>PK log_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="application_id">FK application_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="old_status">   old_status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(15)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="new_status">   new_status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(15)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="changed_at">   changed_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="changed_by">   changed_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(100)</FONT></TD></TR></TABLE>>];
  Applications [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#cfe8ff"><B>Applications</B></TD></TR><TR><TD ALIGN="LEFT" PORT="application_id"><B>PK application_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="student_id">FK student_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="posting_id">FK posting_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="applied_date">   applied_date</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">   status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">enum(&#x27;APPLIED&#x27;,&#x27;IN_PROGRESS&#x27;,&#x27;SELECTED&#x27;,&#x27;REJECTED&#x27;,&#x27;WITHDRAWN&#x27;)</FONT></TD></TR></TABLE>>];
  Companies [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#cfe8ff"><B>Companies</B></TD></TR><TR><TD ALIGN="LEFT" PORT="company_id"><B>PK company_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">   name</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sector">   sector</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="hq_city">   hq_city</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tier">   tier</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">enum(&#x27;Tier 1&#x27;,&#x27;Tier 2&#x27;,&#x27;Tier 3&#x27;)</FONT></TD></TR></TABLE>>];
  Interview_Rounds [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#cfe8ff"><B>Interview_Rounds</B></TD></TR><TR><TD ALIGN="LEFT" PORT="round_id"><B>PK round_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="application_id">FK application_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="round_no">   round_no</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">tinyint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="round_type">   round_type</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">enum(&#x27;APTITUDE&#x27;,&#x27;TECHNICAL&#x27;,&#x27;GD&#x27;,&#x27;HR&#x27;)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="round_date">   round_date</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="result">   result</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">enum(&#x27;PENDING&#x27;,&#x27;PASS&#x27;,&#x27;REJECT&#x27;,&#x27;SELECT&#x27;)</FONT></TD></TR></TABLE>>];
  Job_Postings [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#cfe8ff"><B>Job_Postings</B></TD></TR><TR><TD ALIGN="LEFT" PORT="posting_id"><B>PK posting_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="company_id">FK company_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role_title">   role_title</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ctc">   ctc</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">decimal(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="min_cgpa">   min_cgpa</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">decimal(4,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="posted_date">   posted_date</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">   status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">enum(&#x27;OPEN&#x27;,&#x27;CLOSED&#x27;)</FONT></TD></TR></TABLE>>];
  Login_Audit [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#cfe8ff"><B>Login_Audit</B></TD></TR><TR><TD ALIGN="LEFT" PORT="log_id"><B>PK log_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">bigint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="username">   username</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="success">   success</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">tinyint(1)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="client_ip">   client_ip</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="at">   at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamp</FONT></TD></TR></TABLE>>];
  Match_Refresh_Queue [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#ffe9b8"><B>Match_Refresh_Queue</B></TD></TR><TR><TD ALIGN="LEFT" PORT="entity_type"><B>PK entity_type</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">enum(&#x27;STUDENT&#x27;,&#x27;POSTING&#x27;)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="entity_id"><B>PK entity_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">   status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">enum(&#x27;PENDING&#x27;,&#x27;DONE&#x27;)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="queued_at">   queued_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamp(6)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="processed_at">   processed_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamp(6)</FONT></TD></TR></TABLE>>];
  Match_Scores [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#c9f2d9"><B>Match_Scores</B></TD></TR><TR><TD ALIGN="LEFT" PORT="score_id"><B>PK score_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="student_id">FK student_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="posting_id">FK posting_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="match_score">   match_score</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">decimal(5,4)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="computed_at">   computed_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="model_run_id">FK model_run_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR></TABLE>>];
  Model_Runs [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#c9f2d9"><B>Model_Runs</B></TD></TR><TR><TD ALIGN="LEFT" PORT="run_id"><B>PK run_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="run_kind">   run_kind</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">enum(&#x27;MATCH&#x27;,&#x27;PLACEMENT&#x27;)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="model_name">   model_name</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="params">   params</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">json</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="metrics">   metrics</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">json</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rows_written">   rows_written</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">   status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">enum(&#x27;RUNNING&#x27;,&#x27;SUCCESS&#x27;,&#x27;FAILED&#x27;)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="started_at">   started_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="finished_at">   finished_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="notes">   notes</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(255)</FONT></TD></TR></TABLE>>];
  Placement_Outcomes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#cfe8ff"><B>Placement_Outcomes</B></TD></TR><TR><TD ALIGN="LEFT" PORT="outcome_id"><B>PK outcome_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="student_id">FK student_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="posting_id">FK posting_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="final_status">   final_status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">enum(&#x27;PLACED&#x27;,&#x27;NOT_PLACED&#x27;)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="offer_ctc">   offer_ctc</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">decimal(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="offer_date">   offer_date</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">date</FONT></TD></TR></TABLE>>];
  Placement_Probability [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#c9f2d9"><B>Placement_Probability</B></TD></TR><TR><TD ALIGN="LEFT" PORT="student_id"><B>PK student_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cycle_year"><B>PK cycle_year</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="probability">   probability</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">decimal(5,4)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="computed_at">   computed_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="model_run_id">FK model_run_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR></TABLE>>];
  Posting_Requirements [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#cfe8ff"><B>Posting_Requirements</B></TD></TR><TR><TD ALIGN="LEFT" PORT="posting_id"><B>PK posting_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="skill_id"><B>PK skill_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="required_level">   required_level</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">tinyint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="weight">   weight</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">decimal(3,2)</FONT></TD></TR></TABLE>>];
  Skills [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#cfe8ff"><B>Skills</B></TD></TR><TR><TD ALIGN="LEFT" PORT="skill_id"><B>PK skill_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="skill_name">   skill_name</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category">   category</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">enum(&#x27;Programming&#x27;,&#x27;Framework&#x27;,&#x27;Data &amp; AI&#x27;,&#x27;Tools &amp; DevOps&#x27;,&#x27;Core CS&#x27;,&#x27;Soft Skill&#x27;,&#x27;Testing&#x27;)</FONT></TD></TR></TABLE>>];
  Student_Academic_Profile [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#ececec"><B>Student_Academic_Profile</B></TD></TR><TR><TD ALIGN="LEFT" PORT="student_id"><B>PK student_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="internships">   internships</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">tinyint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="projects">   projects</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">tinyint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="workshops_certifications">   workshops_certifications</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">tinyint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="aptitude_test_score">   aptitude_test_score</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="soft_skills_rating">   soft_skills_rating</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">decimal(2,1)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="extracurricular_activities">   extracurricular_activities</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">enum(&#x27;Yes&#x27;,&#x27;No&#x27;)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="placement_training">   placement_training</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">enum(&#x27;Yes&#x27;,&#x27;No&#x27;)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ssc_marks">   ssc_marks</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="hsc_marks">   hsc_marks</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint unsigned</FONT></TD></TR></TABLE>>];
  Student_Skills [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#cfe8ff"><B>Student_Skills</B></TD></TR><TR><TD ALIGN="LEFT" PORT="student_id"><B>PK student_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="skill_id"><B>PK skill_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="proficiency_level">   proficiency_level</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">tinyint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="evidence_source">   evidence_source</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">enum(&#x27;Course&#x27;,&#x27;Project&#x27;,&#x27;Certification&#x27;,&#x27;Internship&#x27;,&#x27;Self-Declared&#x27;)</FONT></TD></TR></TABLE>>];
  Students [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#cfe8ff"><B>Students</B></TD></TR><TR><TD ALIGN="LEFT" PORT="student_id"><B>PK student_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">   name</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email">   email</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="branch">   branch</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cgpa">   cgpa</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">decimal(4,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="batch_year">   batch_year</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="resume_url">   resume_url</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">   created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">timestamp</FONT></TD></TR></TABLE>>];
  App_Users -> Companies [taillabel="N" headlabel="1" fontsize=8];
  App_Users -> Students [taillabel="N" headlabel="1" fontsize=8];
  Application_Status_Log -> Applications [taillabel="N" headlabel="1" fontsize=8];
  Applications -> Job_Postings [taillabel="N" headlabel="1" fontsize=8];
  Applications -> Students [taillabel="N" headlabel="1" fontsize=8];
